# Ignore folders with logs
logs/

# Ignore folders with whole qc results
whole_img_qc_output/

# Ignore pycache folders
__pycache__/

# Ignore in-progress work that is not needed for repo
in_progress/*

# Ignore vscode settings
.vscode/

# Ignore CellProfiler SQLite outputs and SLURM job logs
sqlite_outputs/
*.out

# Ignore LoadData CSVs as it is created per run with specific paths
loaddata_csvs

# Ignore converted and processed profiles (large parquet files) and parsl run info from CytoTable
4.preprocess_features/data/
runinfo/

# Ignore single-cell QC figures and results (regenerated by 1.sc_quality_control.ipynb from the
# thresholds tracked in 4.preprocess_features/qc_thresholds.yml)
4.preprocess_features/qc_figures/
4.preprocess_features/qc_results/

# Ignore executed single-cell QC notebooks per cell line (created by run_pipeline.sh)
4.preprocess_features/executed_notebooks/

# Ignore MorphEm profiles (large parquet files)
5.morphem_featurization/data/

# Ignore the crop size evaluation tables (regenerated by 0.evaluate_crop_sizes.ipynb; the figures summarize them)
5.morphem_featurization/crop_evaluation/

# Ignore uv virtual environments (created from the lock files in environments/)
.venv/

# Ignore build metadata from installing utils/ in editable mode
*.egg-info/
